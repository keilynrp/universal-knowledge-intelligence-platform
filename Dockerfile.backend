FROM python:3.13-slim

WORKDIR /app

ARG APP_VERSION=local
ENV UKIP_APP_VERSION=$APP_VERSION
LABEL org.opencontainers.image.revision=$APP_VERSION

# System deps (lxml, psycopg2 native libs).
#
# The pango/harfbuzz trio is WeasyPrint's native runtime: the `weasyprint` pip
# package in requirements.txt is only a ctypes binding, so without these the
# import raises OSError and POST /exports/pdf answers 501 for every caller.
# fonts-dejavu-core arrives transitively today, but it is named explicitly
# because the report stylesheet resolves to a generic `sans-serif`
# (backend/report_builder.py) — with no font installed the PDF renders blank
# rather than failing loudly.
#
# `apt-get upgrade` pulls Debian security fixes the upstream python:3.13-slim
# tag has not been rebuilt with yet. `pull: true` in CI only fetches the newest
# tag, not the newest packages: perl-base shipped 3 CRITICAL CVEs for days after
# 5.40.1-6+deb13u1 was published, and Trivy blocked every PR (issue #336).
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    libxml2-dev libxslt-dev libpq-dev gcc curl \
    libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Python deps.
#
# `-c requirements.lock` is what CI already installs with. Without it here the
# image resolved requirements.txt freely while CI resolved it under the lock,
# and the two drifted to sharing only half their versions — including bcrypt
# and starlette across major releases. Every gate therefore approved a
# dependency set that never reached production (issue #201).
#
# The lock is now generated FROM this image, so it describes what actually
# ships; see the header of requirements.lock before refreshing it.
COPY requirements.txt requirements.lock ./
RUN pip install --no-cache-dir -r requirements.txt -c requirements.lock

# Application source
COPY . .

# Alembic config must be at project root
ENV PYTHONPATH=/app

RUN chmod +x /app/docker/backend-entrypoint.sh

EXPOSE 8000

CMD ["/app/docker/backend-entrypoint.sh"]
